{
  "name": "backend",
  "version": "1.0.0",
  "description": "Automates entering scanned biometry/topography values into the Barrett Universal II IOL calculator.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "NODE_OPTIONS=--experimental-sqlite tsx watch src/server.ts",
    "build": "tsc",
    "start": "node --experimental-sqlite dist/server.js",
    "inspect": "tsx scripts/inspectBarrett.ts",
    "postinstall": "playwright install chromium",
    "mock": "tsx scripts/mockCalculator.ts",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "playwright": "^1.62.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
