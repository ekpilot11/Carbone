# Optional. Leave unset to use Vite's dev proxy (see vite.config.ts), which
# forwards same-origin /api requests to a backend running on :4000 — this is
# what you want when tunneling a single port (e.g. `ngrok http 5173`).
# Set this only when the frontend and backend are hosted on different origins.
# VITE_API_BASE_URL=https://your-backend-host
